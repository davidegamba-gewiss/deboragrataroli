<svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 800 800">
  <defs>
    <!-- Gradient background -->
    <radialGradient id="bgGradient" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#A86BD9;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#5E2CA5;stop-opacity:1" />
    </radialGradient>

    <!-- Subtle pattern -->
    <pattern id="pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
      <circle cx="20" cy="20" r="1" fill="#E2C7FF" opacity="0.3"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="800" height="800" fill="url(#bgGradient)"/>
  <rect width="800" height="800" fill="url(#pattern)"/>

  <!-- Microphone icon -->
  <g transform="translate(400, 300)">
    <!-- Mic body -->
    <rect x="-40" y="-120" width="80" height="160" rx="40" fill="#ffffff" opacity="0.9"/>

    <!-- Mic details -->
    <rect x="-30" y="-110" width="60" height="10" rx="5" fill="#E2C7FF"/>
    <rect x="-30" y="-80" width="60" height="10" rx="5" fill="#E2C7FF"/>
    <rect x="-30" y="-50" width="60" height="10" rx="5" fill="#E2C7FF"/>

    <!-- Mic stand -->
    <path d="M -60 60 Q -60 90 0 90 Q 60 90 60 60" stroke="#ffffff" stroke-width="6" fill="none" opacity="0.9"/>
    <line x1="0" y1="40" x2="0" y2="90" stroke="#ffffff" stroke-width="6" opacity="0.9"/>

    <!-- Base -->
    <ellipse cx="0" cy="90" rx="70" ry="15" fill="#ffffff" opacity="0.9"/>
  </g>

  <!-- Text -->
  <text x="400" y="550" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#ffffff" text-anchor="middle" opacity="0.9">
    DEBORA GRATAROLI
  </text>

  <text x="400" y="600" font-family="Arial, sans-serif" font-size="28" fill="#E2C7FF" text-anchor="middle" opacity="0.8">
    Foto placeholder - Da sostituire
  </text>
</svg>
